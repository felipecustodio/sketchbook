#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -ne 1 ]; then
  echo "Usage: $(basename "$0") <target-directory>" >&2
  exit 1
fi

script_dir="$(cd -- "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd -- "$script_dir/.." && pwd)"
template_dir="$repo_root/templates/pde-starter"

target_dir="$1"
sketch_name="$(basename "$target_dir")"
mkdir -p "$target_dir"

rsync --info=progress2 -a "$template_dir/" "$target_dir/"

if [ -f "$target_dir/pde-starter.pde" ]; then
  mv "$target_dir/pde-starter.pde" "$target_dir/${sketch_name}.pde"
fi
